---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';

const allPosts = await getCollection('blog', ({ data }) => !data.lang || data.lang === 'fr');
allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1, 7);
---

<Layout title="123fenetre.fr — Guide & Comparateur Fenêtres PVC, Alu, Bois & Isolation RGE" description="L'observatoire indépendant de la menuiserie et du vitrage : comparatifs PVC vs Aluminium, double et triple vitrage, isolation phonique et aides MaPrimeRénov'.">
  <!-- Hero Section Style Lexington Carrington -->
  <section class="relative bg-slate-950 text-white overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-sky-950 text-sky-300 border border-sky-800 mb-6">
            <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
            Observatoire Indépendant de la Menuiserie & de la Rénovation Thermique
          </div>
          
          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight font-sans">
            L'Excellence Technique pour Vos <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-blue-500">Fenêtres & Menuiseries</span>
          </h1>
          
          <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl font-normal leading-relaxed">
            Comparatifs impartiaux de matériaux (PVC, Alu, Bois), coefficients thermiques Uw certifiés, guides d'isolation acoustique et simulation des aides d'État 2026.
          </p>

          <div class="mt-8 flex flex-wrap gap-4 items-center">
            <a href="#dossiers" class="px-6 py-3.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm tracking-wide transition-all shadow-lg shadow-sky-500/20">
              Explorer les Dossiers Techniques &darr;
            </a>
            <a href="/blog/" class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm border border-slate-700 transition-all">
              Consulter les 39 Articles &rarr;
            </a>
          </div>

          <!-- Quick Metrics Bar -->
          <div class="mt-12 grid grid-cols-3 gap-6 pt-8 border-t border-slate-800/80">
            <div>
              <div class="text-2xl sm:text-3xl font-black text-sky-400">Uw ≤ 1.1</div>
              <div class="text-xs text-slate-400 mt-1">Isolation Haute Performance</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-white">Jusqu'à -40%</div>
              <div class="text-xs text-slate-400 mt-1">Déperditions Thermiques</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-black text-sky-400">RGE 2026</div>
              <div class="text-xs text-slate-400 mt-1">Éligibilité MaPrimeRénov'</div>
            </div>
          </div>
        </div>

        <!-- Featured Bento Card -->
        {featuredPost && (
          <div class="lg:col-span-5">
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 relative shadow-2xl group hover:border-sky-500/40 transition-all">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-sky-400 bg-sky-950 px-3 py-1 rounded-full border border-sky-800/60">
                  À la Une de la Rédaction
                </span>
                <span class="text-xs text-slate-400 font-mono">
                  {new Date(featuredPost.data.pubDate).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h2 class="text-2xl font-bold text-white group-hover:text-sky-300 transition-colors leading-snug">
                <a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
              </h2>
              {featuredPost.data.description && (
                <p class="mt-3 text-slate-300 text-sm line-clamp-3 leading-relaxed">
                  {featuredPost.data.description}
                </p>
              )}
              <div class="mt-6 pt-6 border-t border-slate-800 flex items-center justify-between">
                <span class="text-xs text-slate-400 font-medium">Catégorie: <strong class="text-slate-200">{featuredPost.data.category}</strong></span>
                <a href={`/blog/${featuredPost.id}/`} class="text-xs font-bold text-sky-400 group-hover:text-sky-300 flex items-center gap-1">
                  Lire l'enquête complète &rarr;
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Bento Grid Architecture Section -->
  <section id="dossiers" class="py-20 bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-sky-500 mb-2">Guides Pratiques & Enquêtes</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">Les Thématiques Clés de la Rénovation</p>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-400">Tout ce que vous devez savoir avant de signer votre devis de menuiserie extérieure.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 hover:border-sky-500 transition-all flex flex-col justify-between group shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                  {post.data.category || 'Menuiserie'}
                </span>
                <span class="text-xs text-slate-400">
                  {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors line-clamp-2 mb-2">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              {post.data.description && (
                <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-500 dark:text-slate-400">Guide vérifié</span>
              <a href={`/blog/${post.id}/`} class="text-xs font-bold text-sky-600 dark:text-sky-400 group-hover:translate-x-1 transition-transform">
                Lire &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/blog/" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold text-sm hover:bg-sky-600 dark:hover:bg-sky-400 transition-all shadow-md">
          Voir l'Intégralité des 39 Guides & Enquêtes &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- International Editions Callout -->
  <section class="py-12 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4">International Editions / Ediciones Internacionales</p>
      <div class="flex justify-center items-center gap-6 text-sm font-semibold">
        <a href="/en/" class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1.5">
          <span>🇬🇧</span> English Edition (Window & Glazing Guides)
        </a>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <a href="/es/" class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1.5">
          <span>🇪🇸</span> Edición en Español (Guías de Ventanas y Aislamiento)
        </a>
      </div>
    </div>
  </section>
</Layout>
